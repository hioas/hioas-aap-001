# aap-server 环境变量模板（复制到 E:\env\aap-server.env 后填真实值；真实文件不入库）
#
# 载入方式（bash）：
#   set -a; . /e/env/aap-server.env; set +a
# 或直接用包装脚本：
#   tools/with-env.sh aap-server mvn -B -ntp test

# --- PostgreSQL（复用 E:\docker\dev\postgres 的 dev_postgres 实例，不另起容器） ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aap_server_dev
DB_TEST_NAME=aap_server_test
DB_USER=
DB_PASSWORD=

# --- 应用密钥（生成：openssl rand -base64 32 / openssl rand -base64 48） ---
# JWT（HS256）签名密钥
AAP_JWT_SECRET=
# 凭证 api_key 落库加密密钥（AES-256-GCM，必须 32 字节的 base64）
AAP_CREDENTIAL_AES_KEY=
# 可选
AAP_JWT_ACCESS_TTL_MINUTES=120
AAP_JWT_REFRESH_TTL_DAYS=14
SERVER_PORT=8083
LOG_DIR=logs
