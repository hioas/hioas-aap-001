# 统一换行：仓库内一律 LF，检出时按平台
* text=auto eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制，不做换行转换与 diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.jar binary

# 语言统计与 diff 提示
*.java linguist-language=Java
*.vue  linguist-language=Vue
