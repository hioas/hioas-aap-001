{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "admin-user-create",
  "required": [
    "username",
    "role",
    "phone"
  ],
  "properties": {
    "username": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "display_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "role": {
      "type": "string",
      "enum": [
        "BIZ_OPERATOR",
        "TECH_OPS",
        "SUPER_ADMIN"
      ]
    },
    "phone": {
      "type": "string",
      "pattern": "^1[3-9]\\d{9}$"
    }
  },
  "type": "object",
  "additionalProperties": true
}
