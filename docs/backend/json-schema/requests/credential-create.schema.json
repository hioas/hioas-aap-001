{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hioas.com/aap/schema/credential-create",
  "title": "credential-create",
  "required": [
    "base_url",
    "api_key"
  ],
  "properties": {
    "alias": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 2,
      "maxLength": 64
    },
    "base_url": {
      "type": "string",
      "format": "uri"
    },
    "api_key": {
      "type": "string",
      "minLength": 8
    },
    "primary_flag": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "is_primary": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "declared_vendor": {
      "type": [
        "string",
        "null"
      ]
    },
    "declared_rpm": {
      "type": [
        "integer",
        "null"
      ]
    },
    "declared_tpm": {
      "type": [
        "integer",
        "null"
      ]
    },
    "declared_context_window": {
      "type": [
        "integer",
        "null"
      ]
    },
    "env_tag": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_list": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "../models/model-entry.schema.json"
      }
    }
  },
  "type": "object",
  "additionalProperties": true
}
