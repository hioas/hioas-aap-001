{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "settlement-generate",
  "required": [
    "provider_id",
    "month"
  ],
  "properties": {
    "provider_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    }
  },
  "type": "object",
  "additionalProperties": true
}
