{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "auth-sms-login",
  "required": [
    "phone",
    "smsCode"
  ],
  "properties": {
    "phone": {
      "type": "string",
      "pattern": "^1[3-9]\\d{9}$"
    },
    "smsCode": {
      "type": "string",
      "pattern": "^\\d{6}$"
    }
  },
  "type": "object",
  "additionalProperties": true
}
