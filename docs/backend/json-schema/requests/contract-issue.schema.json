{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contract-issue",
  "required": [
    "file_id"
  ],
  "properties": {
    "file_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "cooperation_mode": {
      "type": [
        "string",
        "null"
      ]
    },
    "settlement_cycle": {
      "type": [
        "string",
        "null"
      ]
    },
    "platform_fee_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "min_settlement_amount": {
      "type": [
        "number",
        "null"
      ],
      "description": "numeric(18,6)：USD 或 USD/1M tokens"
    },
    "terms": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "sign_deadline": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    }
  },
  "type": "object",
  "additionalProperties": true
}
