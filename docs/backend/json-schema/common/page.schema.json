{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "page",
  "description": "分页响应包装：{items,page,pageSize,total}（字段名以 aap-client 读法为准）",
  "required": [
    "items",
    "page",
    "pageSize",
    "total"
  ],
  "properties": {
    "items": {
      "type": "array"
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "total": {
      "type": "integer",
      "minimum": 0
    }
  },
  "type": "object",
  "additionalProperties": true
}
