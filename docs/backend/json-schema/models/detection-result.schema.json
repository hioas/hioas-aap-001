{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hioas.com/aap/schema/detection-result",
  "title": "detection-result",
  "required": [
    "probe_code",
    "status"
  ],
  "properties": {
    "probe_code": {
      "type": "string",
      "pattern": "^D[1-8]$"
    },
    "probe_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "FAILED",
        "SKIPPED",
        "NOT_MEASURABLE"
      ]
    },
    "score": {
      "type": [
        "number",
        "null"
      ]
    },
    "weight_original": {
      "type": [
        "number",
        "null"
      ]
    },
    "weight_used": {
      "type": [
        "number",
        "null"
      ]
    },
    "metrics": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "evidence": {},
    "explanation": {
      "type": [
        "string",
        "null"
      ]
    },
    "detail": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt_count": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "type": "object",
  "additionalProperties": true
}
