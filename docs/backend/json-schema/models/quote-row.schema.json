{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hioas.com/aap/schema/quote-row",
  "title": "quote-row",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "quote_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "quote_no": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DRAFT",
        "SUBMITTED",
        "IN_REVIEW",
        "REJECTED",
        "APPROVED",
        "CONTRACT_CREATED",
        "CONVERTED",
        "VOID",
        null
      ]
    },
    "currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "item_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "items": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      }
    },
    "amount_total": {
      "type": [
        "number",
        "null"
      ],
      "description": "numeric(18,6)：USD 或 USD/1M tokens"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "contract_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "credential_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    }
  },
  "type": "object",
  "additionalProperties": true
}
