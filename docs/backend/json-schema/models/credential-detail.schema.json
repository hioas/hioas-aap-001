{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "credential-detail",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "provider_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "alias": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "api_key_mask": {
      "type": [
        "string",
        "null"
      ]
    },
    "api_key_masked": {
      "type": [
        "string",
        "null"
      ]
    },
    "primary_flag": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "is_primary": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "declared_vendor": {
      "type": [
        "string",
        "null"
      ]
    },
    "declared_rpm": {
      "type": [
        "integer",
        "null"
      ]
    },
    "declared_tpm": {
      "type": [
        "integer",
        "null"
      ]
    },
    "declared_context_window": {
      "type": [
        "integer",
        "null"
      ]
    },
    "model_list": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "model-entry.schema.json"
      }
    },
    "model_catalog": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "vendor-group.schema.json"
      }
    },
    "env_tag": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "PENDING_PRECHECK",
        "PRECHECK_PASSED",
        "PRECHECK_FAILED",
        "ACTIVE",
        "INVALID",
        null
      ]
    },
    "detection_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "PENDING",
        "RUNNING",
        "PASS",
        "FAIL",
        null
      ]
    },
    "latest_report_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "precheck_passed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "precheck_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "version": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "type": "object",
  "additionalProperties": true
}
