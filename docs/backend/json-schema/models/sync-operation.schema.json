{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hioas.com/aap/schema/sync-operation",
  "title": "sync-operation",
  "properties": {
    "id": {
      "type": "string",
      "description": "雪花 ID（对外 string，避免 JS 精度丢失）"
    },
    "operation": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_payload": {
      "type": [
        "object",
        "null"
      ]
    },
    "response_payload": {
      "type": [
        "object",
        "null"
      ]
    },
    "result": {
      "type": [
        "string",
        "null"
      ]
    },
    "readback_equal": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "attempt_no": {
      "type": [
        "integer",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    }
  },
  "type": "object",
  "additionalProperties": true
}
