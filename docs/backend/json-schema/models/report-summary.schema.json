{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hioas.com/aap/schema/report-summary",
  "title": "report-summary",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "雪花 ID（对外 string，避免 JS 精度丢失）"
    },
    "report_id": {
      "type": "string",
      "description": "雪花 ID（对外 string，避免 JS 精度丢失）"
    },
    "report_no": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "PASS",
        "FAIL",
        "MANUAL_REVIEW",
        null
      ]
    },
    "total_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "confidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "detected_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "provider_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "credential_id": {
      "type": "string",
      "description": "雪花 ID（对外 string，避免 JS 精度丢失）"
    },
    "channel_name": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "type": "object",
  "additionalProperties": true
}
