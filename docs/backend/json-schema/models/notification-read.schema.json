{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "notification-read",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "read_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    }
  },
  "type": "object",
  "additionalProperties": true
}
