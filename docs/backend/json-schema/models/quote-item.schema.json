{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hioas.com/aap/schema/quote-item",
  "title": "quote-item",
  "required": [
    "item_id",
    "quote_id",
    "model_name"
  ],
  "properties": {
    "item_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "quote_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "quoteId": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "model_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "modelName": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_alias": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_price": {
      "type": [
        "number",
        "null"
      ],
      "description": "numeric(18,6)：USD 或 USD/1M tokens"
    },
    "output_price": {
      "type": [
        "number",
        "null"
      ],
      "description": "numeric(18,6)：USD 或 USD/1M tokens"
    },
    "cache_read_price": {
      "type": [
        "number",
        "null"
      ],
      "description": "numeric(18,6)：USD 或 USD/1M tokens"
    },
    "cache_write_price": {
      "type": [
        "number",
        "null"
      ],
      "description": "numeric(18,6)：USD 或 USD/1M tokens"
    },
    "cache_write_1h_price": {
      "type": [
        "number",
        "null"
      ],
      "description": "numeric(18,6)：USD 或 USD/1M tokens"
    },
    "image_input_price": {
      "type": [
        "number",
        "null"
      ],
      "description": "numeric(18,6)：USD 或 USD/1M tokens"
    },
    "audio_input_price": {
      "type": [
        "number",
        "null"
      ],
      "description": "numeric(18,6)：USD 或 USD/1M tokens"
    },
    "image_output_price": {
      "type": [
        "number",
        "null"
      ],
      "description": "numeric(18,6)：USD 或 USD/1M tokens"
    },
    "audio_output_price": {
      "type": [
        "number",
        "null"
      ],
      "description": "numeric(18,6)：USD 或 USD/1M tokens"
    },
    "tier": {
      "type": [
        "string",
        "null"
      ]
    },
    "billing_mode": {
      "type": [
        "string",
        "null"
      ]
    },
    "compile_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "time_rule": {
      "oneOf": [
        {
          "$ref": "price-time-rule.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "tier_rule": {
      "oneOf": [
        {
          "$ref": "price-tier-rule.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_rules": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "request-rule.schema.json"
      }
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "version": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "type": "object",
  "additionalProperties": true
}
