{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quote-detail",
  "required": [
    "quote_id",
    "status"
  ],
  "properties": {
    "quote_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "quote_no": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "credential_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "SUBMITTED",
        "IN_REVIEW",
        "REJECTED",
        "APPROVED",
        "CONTRACT_CREATED",
        "CONVERTED",
        "VOID"
      ]
    },
    "current_version": {
      "type": [
        "integer",
        "null"
      ]
    },
    "currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "item_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "remark": {
      "type": [
        "string",
        "null"
      ]
    },
    "reject_reason_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "reject_reason_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "submitted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "contract_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "source_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "item_total": {
      "type": [
        "integer",
        "null"
      ]
    },
    "items": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "quote-item.schema.json"
      }
    },
    "amount_total": {
      "type": [
        "number",
        "null"
      ],
      "description": "numeric(18,6)：USD 或 USD/1M tokens"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "version": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "type": "object",
  "additionalProperties": true
}
