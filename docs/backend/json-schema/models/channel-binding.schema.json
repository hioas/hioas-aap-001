{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hioas.com/aap/schema/channel-binding",
  "title": "channel-binding",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "binding_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "provider_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "credential_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "endpoint_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "channel_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "channel_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "tag": {
      "type": [
        "string",
        "null"
      ]
    },
    "group_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "priority": {
      "type": [
        "integer",
        "null"
      ]
    },
    "weight": {
      "type": [
        "integer",
        "null"
      ]
    },
    "models": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "NOT_SYNCED",
        "PENDING",
        "SYNCING",
        "SYNCED",
        "PARTIAL",
        "FAILED",
        "ENABLED",
        "DISABLED",
        "ROLLED_BACK",
        null
      ]
    },
    "last_synced_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "last_readback_hash": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "type": "object",
  "additionalProperties": true
}
