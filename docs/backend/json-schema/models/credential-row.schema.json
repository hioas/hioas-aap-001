{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hioas.com/aap/schema/credential-row",
  "title": "credential-row",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "alias": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_list": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      }
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "detection_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "PENDING",
        "RUNNING",
        "PASS",
        "FAIL",
        null
      ]
    },
    "latest_report_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "雪花 ID（对外 string，避免 JS 精度丢失；可空）"
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "api_key_mask": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "type": "object",
  "additionalProperties": true
}
