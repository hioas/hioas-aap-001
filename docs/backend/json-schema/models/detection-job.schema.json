{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hioas.com/aap/schema/detection-job",
  "title": "detection-job",
  "required": [
    "id",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "雪花 ID（对外 string，避免 JS 精度丢失）"
    },
    "job_id": {
      "type": "string",
      "description": "雪花 ID（对外 string，避免 JS 精度丢失）"
    },
    "job_no": {
      "type": [
        "string",
        "null"
      ]
    },
    "credential_id": {
      "type": "string",
      "description": "雪花 ID（对外 string，避免 JS 精度丢失）"
    },
    "provider_id": {
      "type": "string",
      "description": "雪花 ID（对外 string，避免 JS 精度丢失）"
    },
    "status": {
      "type": "string",
      "enum": [
        "QUEUED",
        "RUNNING",
        "PARTIAL_DONE",
        "COMPLETED",
        "REPORT_GENERATED",
        "FAILED"
      ]
    },
    "trigger_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "FIRST",
        "MANUAL",
        "SCHEDULED",
        null
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "total_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "result": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "PASS",
        "FAIL",
        "MANUAL_REVIEW",
        null
      ]
    },
    "confidence": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        null
      ]
    },
    "cost_estimate_usd": {
      "type": [
        "number",
        "null"
      ],
      "description": "numeric(18,6)：USD 或 USD/1M tokens"
    },
    "cost_actual_usd": {
      "type": [
        "number",
        "null"
      ],
      "description": "numeric(18,6)：USD 或 USD/1M tokens"
    },
    "challenge_verified": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_msg": {
      "type": [
        "string",
        "null"
      ]
    },
    "report_id": {
      "type": "string",
      "description": "雪花 ID（对外 string，避免 JS 精度丢失）"
    },
    "attempt_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "progress": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "percent": {
          "type": [
            "number",
            "null"
          ]
        },
        "finished": {
          "type": [
            "integer",
            "null"
          ]
        },
        "total": {
          "type": [
            "integer",
            "null"
          ]
        },
        "eta_minutes": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    }
  },
  "type": "object",
  "additionalProperties": true
}
