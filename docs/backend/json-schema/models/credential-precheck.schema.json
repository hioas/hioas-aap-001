{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hioas.com/aap/schema/credential-precheck",
  "title": "credential-precheck",
  "properties": {
    "id": {
      "type": "string",
      "description": "雪花 ID（对外 string，避免 JS 精度丢失）"
    },
    "credential_id": {
      "type": "string",
      "description": "雪花 ID（对外 string，避免 JS 精度丢失）"
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "connectivity_ok": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "auth_ok": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "models_ok": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_msg": {
      "type": [
        "string",
        "null"
      ]
    },
    "latency_ms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "checked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC3339 UTC"
    }
  },
  "type": "object",
  "additionalProperties": true
}
